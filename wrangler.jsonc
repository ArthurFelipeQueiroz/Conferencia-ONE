{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "conferencia-one-checkin",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "vars": {
    "PUBLIC_APP_URL": "https://arthurfelipequeiroz.github.io/Conferencia-ONE"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "conferencia-one-2026",
      "database_id": "bb82d5b7-e186-41bc-b13c-3f0ec6e40bae",
      "migrations_dir": "migrations"
    }
  ]
}

